# Copy to .env, or let `make up` do it for you.
#
# Everything in this file is optional. Running the agent locally in your
# browser needs none of it. Uncomment a block only when you want that thing.

# ---------------------------------------------------------------------------
# Taking real phone calls, through Twilio
# Full walkthrough in docs/hosting.md. Two lines are required: the hostname
# and the auth token. The four Groq lines under them are optional.
# ---------------------------------------------------------------------------

# The public hostname Twilio reaches, from `ngrok http 8080`.
# Hostname only, no scheme and no path. Free ngrok changes it every restart,
# and a stale value here is what makes a genuine Twilio call return 403.
# TWILIO_WS_DOMAIN=abc123.ngrok-free.app

# Twilio console, Account Info. Verifies the webhook signature.
# TWILIO_AUTH_TOKEN=

# A local model answers in about 1.6s, an audible pause mid-call. Groq removes
# it. Leave these four commented out and the call runs on your own machine.
# Key from console.groq.com. LLM_BASE_URL already points at Groq.
# LLM_PROVIDER=groq
# LLM_API_KEY=
# SMALL_MODEL_ID=llama-3.1-8b-instant
# BIG_MODEL_ID=llama-3.3-70b-versatile

# ---------------------------------------------------------------------------
# Speech vendors, on the phone path
#
# The agent never sees audio: speech-to-text and text-to-speech happen below
# the telephony port, so the vendor is configuration rather than code. These
# are the defaults already in use, shown so they can be changed. They apply to
# ConversationRelay only; the browser path uses the Web Speech API and ignores
# them. Providers and voices must be enabled on your Twilio account first.
# ---------------------------------------------------------------------------

# Text to speech. ElevenLabs, Google or Amazon.
# VOICE is that provider's voice id, so it changes with the provider.
# TTS_PROVIDER=ElevenLabs
# VOICE=XrExE9yKIg1WjnnlVkGX

# Speech to text. Deepgram or Google.
# SPEECH_MODEL is that provider's model name.
# TRANSCRIPTION_PROVIDER=Deepgram
# SPEECH_MODEL=nova-3-general
# DEEPGRAM_SMART_FORMAT=true

# LANGUAGE=en-US
# TRANSCRIPTION_LANGUAGE=en-US

# Words the recogniser should expect. Short closed-set answers are what it gets
# wrong, so the survey's own option labels belong here.
# TRANSCRIPTION_HINTS=yes,no,phone,web,email,address,mornings,afternoons,evenings

# ---------------------------------------------------------------------------
# Ports, if something on your machine already owns one
#
# Postgres is deliberately not published to the host at all. These two are,
# because the browser needs them. Changing RUNNER_PORT rebuilds the dashboard,
# because the WebSocket URL is baked into its client bundle.
# ---------------------------------------------------------------------------

# DASHBOARD_PORT=3000
# RUNNER_PORT=8080

# ---------------------------------------------------------------------------
# Using your own Ollama instead of Docker Model Runner
# ---------------------------------------------------------------------------

# Nothing here is needed by default: `make up` uses Docker Model Runner, which
# ships with Docker and runs the model on the GPU. If you would rather use an
# Ollama you already have, point at it and name its models. Everything else
# stays the same, because the runner only ever sees a base URL.
# OLLAMA_BASE_URL=http://host.docker.internal:11434
# SMALL_MODEL_ID=qwen2.5:7b-instruct
# BIG_MODEL_ID=llama3.1:8b
#
# On Linux, also set OLLAMA_HOST=0.0.0.0:11434 on the Ollama service itself, or
# the container cannot reach it. Ollama binds 127.0.0.1 by default. See
# https://github.com/ollama/ollama/blob/main/docs/faq.mdx

# ---------------------------------------------------------------------------
# Optional extras
# ---------------------------------------------------------------------------

# Have Twilio record the call, so you can post the audio. Recordings show up
# under Monitor, Logs, Calls in the console.
# TWILIO_RECORDING_ENABLED=true

# Bridge the caller to a real person when the agent decides to hand over.
# Off by default, because with it on and no number set the runner hangs up on
# your caller instead.
# COACH_HANDOFF_ENABLED=true
# COACH_PHONE_NUMBER=+441234567890
