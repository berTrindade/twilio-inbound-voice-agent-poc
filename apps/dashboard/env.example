# Dashboard settings, for running it outside Docker.
# With Docker Compose you do not need this file. Use the root .env instead.

# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/survey_db
# Local Postgres has no TLS; the client requires it unless you disable it here.
DATABASE_SSL=disable

# WebSocket URL for the Chat test client (/chat route)
# Default: local voice-agent (ws://localhost:8080/ws)
NEXT_PUBLIC_WS_URL=ws://localhost:8080/ws

# Chat test client (/chat route visibility)
# Set to "true" to show the Chat link in the navigation
SHOW_CHAT=true

# Encryption (must match the call runner ENCRYPTION_KEY)
# If unset, encrypted values are returned as-is (passthrough mode).
ENCRYPTION_KEY=
