# Call runner settings, for running it outside Docker.
# With Docker Compose you do not need this file. Use the root .env instead.
# Every value below is already the code default.

# --- Server ---
ENVIRONMENT=development
VOICE_AGENT_HOST=0.0.0.0
VOICE_AGENT_PORT=8080
LOG_LEVEL=info
LOG_STYLE=text

# --- Database (local Postgres from infra/docker-compose.yml) ---
DATABASE_URL=postgresql://survey_user:survey_pass@localhost:5432/survey_db

# --- LLM: local Ollama (free). Run `ollama serve` then pull the models below. ---
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TIMEOUT_SECONDS=60
SMALL_MODEL_ID=qwen2.5:7b-instruct
BIG_MODEL_ID=llama3.1:8b

# --- Survey content ---
# Defaults point at the demo survey shipped in survey_data/.
# SURVEY_JSON_PATH=/abs/path/to/your_survey.json
# INITIAL_NODE_ID=WELCOME_V1

# --- Encryption (optional). Unset = pass-through (no encryption at rest). ---
# Generate one: python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
# ENCRYPTION_KEY=

# --- Observability (optional). Empty endpoint = telemetry off. ---
OTEL_SERVICE_NAME=voice-agent
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
